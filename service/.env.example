# 本地环境变量（复制为 .env 后填写）
# 勿提交含真实密钥的 .env

# ---------- 云端 AI ----------
# LLM：通用大模型（控制台可选 DeepSeek/豆包/MiMo 预设）的 OpenAI 兼容接口。
# 只需填写这个 Key。
LLM_API_KEY=
# 默认值来自 config.yaml；只有切换供应商或模型时才需要覆盖。
# LLM_PROTOCOL=openai
# LLM_MODEL=mimo-v2.5
# LLM_BASE_URL=https://api.xiaomimimo.com/v1
# 旧版火山方舟安装仍兼容以下变量；新安装不要填写。
# ARK_API_KEY=
# ARK_MODEL=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ASR：默认走火山豆包大模型优化双向流式协议。
# 使用新版火山语音 API Key；不会复用 LLM_API_KEY 或 TTS Key。
ASR_PROVIDER=doubao_streaming
ASR_API_KEY=
# VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# ASR_LANGUAGE=zh-CN
# 显式切换 openai_compatible 时再配置：
# ASR_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
# ASR_MODEL=whisper-1
# ASR_TIMEOUT_SECONDS=30
# ASR_MAX_AUDIO_BYTES=10485760

# 可选本地离线回退（不会自动安装依赖、下载或导出模型）：
# ASR_PROVIDER=funasr
# ASR_MODEL_DIR=./models/SenseVoiceSmall
# 安装命令：pip install -e '.[local-asr]'

# ---------- 常用可选 ----------
# 生产部署必须显式声明；TLS 反代标志即使在漏设此项时也会触发 fail-closed，
# 但不能用来替代清晰的生产环境配置。
# DESKBOT_ENV=production

# 主配置文件（默认 config.yaml）
# DESKBOT_SERVER_CONFIG=config.yaml

# LLM 流式首字超时（秒，仅 openai 等流式协议；ark_responses 默认关闭）
# LLM_FIRST_TOKEN_TIMEOUT=15
# 支持显式切换 openai / dashscope / ark / ark_responses；默认见上方 MiMo 配置。
# Provider URL 默认必须为公网 HTTPS/WSS，并阻断回环、内网和云元数据地址。
# 如确需连接运维方明确管理的本机/内网模型，逐个列出精确 origin（不含路径）：
# DESKBOT_PROVIDER_PRIVATE_ORIGINS=http://127.0.0.1:11434,ws://127.0.0.1:8765
# 以下两个降级开关只允许临时开发使用，生产环境不得开启：
# DESKBOT_ALLOW_INSECURE_PROVIDER_HTTP=0
# DESKBOT_ALLOW_INSECURE_PROVIDER_WS=0

# USB CDC 设备链路（默认启用，仅自动探测 Espressif USB 串口）
# 显式端口会跳过自动枚举，例如 Windows：
# DESKBOT_SERIAL_PORTS=COM4
# DESKBOT_USB_SERIAL_ENABLED=1
# DESKBOT_USB_SERIAL_BAUD=115200
# DESKBOT_USB_SERIAL_READ_TIMEOUT=0.02
# DESKBOT_USB_SERIAL_WRITE_TIMEOUT=2
# DESKBOT_USB_SERIAL_SCAN_INTERVAL=1
# DESKBOT_USB_SERIAL_RECONNECT_DELAY=1
# DESKBOT_USB_SERIAL_HELLO_TIMEOUT=6
# 调试时才允许探测全部串口；默认 0，服务不会终止占用串口的其它进程。
# DESKBOT_USB_SERIAL_PROBE_ALL=0

# 兼容旧版阿里云 DashScope（可选）
# DASHSCOPE_API_KEY=

# Core HTTP 与浏览器调试 WebSocket
# 默认仅监听回环；公网或局域网部署必须显式配置 TLS/反向代理和防火墙。
# DESKBOT_SERVER_HOST=127.0.0.1
# DESKBOT_SERVER_PORT=9000
# DESKBOT_WS_PING_INTERVAL=120
# DESKBOT_WS_PING_TIMEOUT=300
# WS_SEND_TIMEOUT_SEC=10
# 生产环境默认拒绝把 API Key 放进 URL 查询串，只接受 X-API-Key / Authorization。
# DESKBOT_ALLOW_API_KEY_IN_QUERY=0
# 生产环境必须二选一：
# 1) Python 服务直接终止 TLS（证书链和私钥均不得提交 Git）：
# DESKBOT_SERVER_TLS_CERT=/run/secrets/deskbot/fullchain.pem
# DESKBOT_SERVER_TLS_KEY=/run/secrets/deskbot/privkey.pem
# 2) 由反向代理终止 TLS；此时 DESKBOT_SERVER_HOST 必须为 127.0.0.1/::1，
#    防止公网绕过代理直接访问明文 WebSocket：
# DESKBOT_TLS_TERMINATED_BY_PROXY=1

# TTS 后端：火山引擎豆包流式 TTS 2.0（默认且唯一运行时实现）
TTS_PROVIDER=doubao
# 凭证见下方 DOUBAO_TTS_*；不要复用 LLM_API_KEY。
# 旧 TTS_SAMPLE_RATE 仍兼容读取；新配置请使用 DOUBAO_TTS_SAMPLE_RATE。

# pb 脸动画（默认：deskbot-face.json 的 emotions + phonemes）
# DESKBOT_PB_FACE_BUNDLE=demo
# DESKBOT_PB_FACE_BUNDLE_JSON=/path/to/custom_face_bundle.json
# DESKBOT_PB_FACE_BUNDLE_FILE=/path/to/overlay.yaml

# USB 设备下行开关（见 config.yaml server.*）
# DESKBOT_DEVICE_PB_ONLY=1
# DESKBOT_MINIMAL_DEVICE_DOWNLINK=0

# Flask Web 服务（默认仅监听回环地址）
DESKBOT_WEB_HOST=127.0.0.1
# DESKBOT_WEB_PORT=5050
# DESKBOT_WEB_PUBLIC_HOST=
# Browser-facing WebSocket origin.  Required when a reverse proxy exposes
# :9000 on another host, port or path, for example:
# DESKBOT_WS_PUBLIC_BASE=wss://deskbot.example.com/realtime
# Optional web-to-realtime internal URL (normally loopback plaintext behind
# the same host):
# DESKBOT_SERVER_INTERNAL_BASE=http://127.0.0.1:9000
# 生产 Web 控制台必须由 HTTPS 反向代理终止 TLS，并改为仅监听回环地址：
# DESKBOT_WEB_HOST=127.0.0.1
# DESKBOT_WEB_TLS_TERMINATED_BY_PROXY=1
# 启用 Flask 开发服务器 debug 模式（默认关闭；生产环境切勿开启）
# DESKBOT_WEB_DEBUG=0

# ---------- 本机 Web 控制台 ----------
# 默认只允许 127.0.0.1/::1；设备完成 USB hello 后自动出现在连接设备列表。
# Flask session 与 debug token 签名密钥（Web→Core 走本机 API Key），
# 至少 32 字符。
# start.sh 仅在纯本地开发未配置时生成本次启动的随机临时值；生产或任一 TLS
# 反代标志开启时，缺少持久密钥会直接拒绝启动。
# DESKBOT_WEB_SECRET_KEY=
# 浏览器调试 WebSocket 短期内部令牌有效秒数（默认 600，范围 60..3600）。
# Short-lived browser/CLI debug bearer token lifetime (60..3600 seconds).
# DESKBOT_DEBUG_WS_TOKEN_SECONDS=600
# Debug tokens in URL query strings are rejected by default in every
# environment unless this temporary migration switch is explicitly enabled:
# DESKBOT_ALLOW_DEBUG_TOKEN_IN_QUERY=0
# DESKBOT_DB_PATH=./data/opendesk.db
# Async device-control deadline, worker lease, and terminal-ledger retention.
# DESKBOT_CONTROL_OPERATION_TIMEOUT_SEC=900
# DESKBOT_CONTROL_OPERATION_LEASE_SEC=45
# DESKBOT_CONTROL_OPERATION_RETENTION_DAYS=30
# DESKBOT_CONTROL_OPERATION_CLEANUP_INTERVAL_SEC=3600
# Terminal PB playback receipts close the reminder played-ACK/DB-finish
# crash window. Keep retention longer than the maximum reminder retry horizon.
# DESKBOT_PLAYBACK_RECEIPT_RETENTION_DAYS=30
# DESKBOT_PLAYBACK_RECEIPT_CLEANUP_INTERVAL_SEC=3600
# 首次启动自动创建免费体验 API Key（每日 1GB），写入 data/.free_api_key
# 每个有效语音轮次在调用 LLM/TTS 前原子预留的额度；成功后按实际用量结算，
# 失败或取消会退款。该值应覆盖所配置模型单轮最大输出（默认 1 MiB）。
# DESKBOT_LLM_TTS_RESERVE_BYTES=1048576

# 摄像头（默认读 config.yaml camera_face.*）
# CAMERA_FACE_LANDMARKER_PATH=
# CAMERA_UNDISTORT=0
# CAMERA_CALIB_JSON=
# CAMERA_MIN_FACE_DETECTION_CONFIDENCE=
# CAMERA_MIN_FACE_PRESENCE_CONFIDENCE=

# 日志
# DESKBOT_SERVER_LOG_FILE=app.log
# DESKBOT_SERVER_LOG_LEVEL=INFO

# ---------- 火山引擎豆包流式 TTS 2.0（V3 双向 WebSocket）----------
# 新安装只需填写这一个语音合成 Key；留空不会写入任何内置凭证。
DOUBAO_TTS_API_KEY=
# DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_MODEL=seed-tts-2.0-standard
# DOUBAO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# DOUBAO_TTS_SAMPLE_RATE=16000
# DOUBAO_TTS_FORMAT=pcm
# DOUBAO_TTS_ENABLE_TIMESTAMP=1
# 声音复刻状态会访问云供应商：按任务跨进程限频，并计入每日云调用额度。
# DESKBOT_VOICE_CLONE_STATUS_JOB_INTERVAL_SEC=5

# ---------- 启动脚本 ----------
# 跳过 pip 重装（venv 须已完整）
FAST_START=0
# LiveKit realtime voice (shared with the team's YareLampGo deployment)
DESKBOT_RTC_ENABLED=1
# Default: Core starts a loopback-only LiveKit Server and LampGo signs room
# JWTs locally. Run tools/install_livekit_windows.ps1 once on Windows.
DESKBOT_LOCAL_LIVEKIT_ENABLED=1
DESKBOT_LIVEKIT_URL=http://127.0.0.1:7880
DESKBOT_RTC_TOKEN_ENDPOINT=http://127.0.0.1:18790/rtc/token
# DESKBOT_LOCAL_LIVEKIT_BINARY=C:\path\to\livekit-server.exe
DESKBOT_RTC_AGENT_NAME=lampgo-jarvis
# stable | interruptible | esp32_aec
DESKBOT_RTC_CALL_MODE=esp32_aec
# RTC automatically reuses ASR_API_KEY and DOUBAO_TTS_API_KEY through the
# Deskbot Seed Speech adapters. Legacy VOLCENGINE_APP_ID +
# VOLCENGINE_ACCESS_TOKEN remain supported, but are not required.
DESKBOT_RTC_TOKEN_API_KEY=livekit-token
DESKBOT_RTC_AGENT_REGISTRATION_TOKEN=livekit-token
# Optional plain-speech persona override. Unlike the structured PB prompt,
# this prompt must ask the RTC model to return only text that should be spoken.
# DESKBOT_RTC_SYSTEM_PROMPT=
# DESKBOT_RTC_SDK_LOG=INFO
